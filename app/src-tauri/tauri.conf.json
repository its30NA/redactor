{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Redactor",
  "mainBinaryName": "Redactor",
  "version": "2.0.0",
  "identifier": "io.github.its30na.redactor",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true,
      "capabilities": [
        "main"
      ],
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "../isolation"
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Strips secrets out of text before you paste it anywhere.",
    "copyright": "Copyright (c) 2026 Sina Kashani. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Redactor"
      }
    }
  }
}
